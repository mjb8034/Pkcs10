<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisMode>all</AnalysisMode>

		<PackageId>Pkcs10</PackageId>
		<Version>1.0.0</Version>

		<Title>PKCS #10 for .NET</Title>
		<Authors>Matthew J. Bobowski</Authors>
		<Copyright>Copyright © 2026 Matthew J. Bobowski</Copyright>
		<Company />
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>

		<Description>
			A native .NET PKCS #10 certificate signing request parser and
			validator using System.Security.Cryptography types, with support
			for RSA and ECDSA requests.
		</Description>

		<PackageTags>
			pkcs10;csr;certificate-signing-request;pki;cryptography
		</PackageTags>

		<RepositoryUrl>https://github.com/mjb8034/Pkcs10</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Update="README.md"
          Pack="true"
          PackagePath="\" />
	</ItemGroup>

</Project>
