<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisMode>all</AnalysisMode>

		<PackageId>Pkcs10</PackageId>
		<Version>1.0.2.0</Version>
		<AssemblyVersion>1.0.1.0</AssemblyVersion>
		<FileVersion>1.0.2.0</FileVersion>

		<!-- Ensure Package compatibility -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>1.0.0.3</PackageValidationBaselineVersion>

		<Title>PKCS #10 for .NET</Title>
		<Authors>Matthew J. Bobowski</Authors>
		<Copyright>Copyright © 2026 Matthew J. Bobowski</Copyright>
		<Company />
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>

		<Description>
			A native .NET PKCS #10 certificate signing request parser and validator using System.Security.Cryptography types.
		</Description>

		<PackageTags>
			pkcs10;csr;certificate-signing-request;pki;cryptography
		</PackageTags>

		<RepositoryUrl>https://github.com/mjb8034/Pkcs10</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="README.md" />
		<None Include="../../README.md"
          Pack="true"
          PackagePath="" />

		<None Remove="CHANGELOG.md" />
		<None Include="../../CHANGELOG.md"
          Pack="true"
          PackagePath="" />
	</ItemGroup>

</Project>
